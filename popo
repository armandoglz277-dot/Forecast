<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">
<title>Tu wallet en vivo · Armando</title><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
:root{--g:#00ff41;--c:#00e5ff;--a:#ffb000;--r:#ff4466}
*{box-sizing:border-box}body{margin:0;background:#000;color:#d8ffe0;font-family:ui-monospace,"Courier New",monospace;font-size:17px;line-height:1.5}
#rain{position:fixed;inset:0;z-index:0;opacity:.12}
main{position:relative;z-index:1;max-width:900px;margin:auto;padding:16px;display:flex;flex-direction:column;gap:20px}
.p{background:rgba(0,14,5,.9);border:1px solid rgba(0,255,65,.6);border-radius:12px;padding:18px;box-shadow:0 0 16px rgba(0,255,65,.25)}
h2{margin:0;font-size:20px;color:var(--g);text-shadow:0 0 8px var(--g)}.q{color:var(--a);font-size:14px;margin:2px 0 14px}
.sum{font-size:20px;color:#fff;border-left:4px solid var(--g);padding-left:12px}
.big{font-size:44px;font-weight:bold;color:var(--g);text-shadow:0 0 14px var(--g)}.mid{font-size:22px;color:var(--c)}
.up{color:var(--g)}.dn{color:var(--r)}.mut{opacity:.65;font-size:14px}a{color:var(--c)}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--g);box-shadow:0 0 10px var(--g);animation:pl 1.2s infinite;margin-right:6px}@keyframes pl{50%{opacity:.2}}
.ag{display:grid;gap:12px;grid-template-columns:1fr}@media(min-width:700px){.ag{grid-template-columns:1fr 1fr}}
.card{border:1px solid rgba(0,229,255,.4);border-radius:10px;padding:12px;display:grid;grid-template-columns:48px 1fr;gap:10px}
.av{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;background:#001a08;border:2px solid var(--g);box-shadow:0 0 10px var(--g)}
.card.busy .av{animation:pl .6s infinite}.nm{color:var(--c);font-weight:bold}.do{font-size:13px;opacity:.75}
.st{margin-top:6px;color:#fff;font-size:15px}.st .t{color:var(--a);font-size:12px;margin-right:6px}
.think::after{content:"▋";animation:pl .8s infinite;color:var(--g)}
#log{max-height:260px;overflow:auto;font-size:14px;background:#000;border:1px dashed rgba(0,255,65,.4);padding:10px;border-radius:8px}#log div{border-bottom:1px solid rgba(0,255,65,.08);padding:3px 0}
.mv{padding:10px 0;border-bottom:1px dashed rgba(0,255,65,.25)}.steps{display:grid;gap:10px}.steps div{border:1px solid rgba(255,176,0,.5);border-radius:8px;padding:10px}.steps b{color:var(--a)}
canvas{max-height:200px}input{background:#000;color:var(--g);border:1px solid var(--g);font:inherit;padding:4px;width:100px}button{background:#002b0b;color:var(--g);border:1px solid var(--g);font:inherit;padding:4px 10px}
</style></head><body><canvas id="rain"></canvas><main>
<div class="mut"><span class="dot"></span><b class="up">EN VIVO</b> · <b style="color:var(--a)">SOLO LECTURA</b> · siguiente revisión en <b id="cd">--</b>s · actualizado hace <b id="ago">--</b>s <span id="err" class="dn"></span></div>
<section class="p"><h2>Resumen en una frase</h2><div class="q">Qué es esto: lo más importante, en palabras simples.</div><div class="sum" id="sum">Revisando tu wallet…</div></section>
<section class="p"><h2>Tu dinero</h2><div class="q">Qué es esto: lo que vale todo lo que tienes ahorita.</div><div class="big" id="usd">$--</div><div class="mid" id="mxn"></div><div id="pnl" class="mid"></div>
<div class="mut" style="margin-top:8px">Tu dinero está en tu cartera de agente de Phantom, <a id="scan" target="_blank" rel="noopener">ver en Solscan</a>.<br>Comparado contra: $<input id="base" type="number" step="0.01"> <button id="sb">guardar</button> · <span id="hold"></span></div></section>
<section class="p"><h2>Tus agentes</h2><div class="q">Qué es esto: 6 ayudantes que revisan datos reales cada 25 segundos. Ninguno puede gastar tu dinero sin tu OK.</div><div class="ag" id="ag"></div></section>
<section class="p"><h2>Bitácora de agentes</h2><div class="q">Qué es esto: lo que cada agente notó, en orden (lo más nuevo arriba).</div><div id="log"></div></section>
<section class="p"><h2>Qué se está moviendo</h2><div class="q">Qué es esto: dinero que entró o salió de tu wallet, con hora de CDMX.</div><div id="mv">Leyendo movimientos…</div></section>
<section class="p"><h2>Precio de SOL (24 h)</h2><div class="q">Qué es esto: cómo se movió el precio de tu moneda en el último día.</div><canvas id="sch"></canvas></section>
<section class="p"><h2>Cómo funciona</h2><div class="q">Qué es esto: el camino que sigue cualquier compra. Nada se salta tu aprobación.</div><div class="steps">
<div><b>1.</b> Los agentes analizan precios y riesgos (lo ves arriba en vivo).</div><div><b>2.</b> Si ven una oportunidad, te proponen una idea con monto y límite de pérdida.</div>
<div><b>3.</b> Tú apruebas (o no) en el chat con Ebun. Sin tu OK no pasa nada.</div><div><b>4.</b> Se ejecuta y aparece aquí en "Qué se está moviendo".</div></div></section>
<div class="mut">Esta página nunca pide llaves ni frase semilla y no firma nada. Datos: RPC público de Solana, CoinGecko, Jupiter, open.er-api.</div>
</main><script>
const ADDR="5MVKHzjVuR7eVXxBcvbfLu9eLjguH9hMKq3YGj8Dutgp",REFRESH=25,TZ="America/Mexico_City";
const RPCS=["https://solana-rpc.publicnode.com","https://api.mainnet-beta.solana.com"],TP=["TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA","TokenzQdBNbLqP5VEhdkAS6EPFLC1PE9qmrLQ5jBPgxq"];
const CG={solana:"SOL",bitcoin:"BTC",ethereum:"ETH","jupiter-exchange-solana":"JUP",bonk:"BONK",dogwifcoin:"WIF"};
const KN={"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v":"USDC","Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB":"USDT","JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN":"JUP","DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263":"BONK","EKpQGSJtjMFqKZ9KQanSqYXRcF8fBopzLHYxdM65zcjm":"WIF"};
const $=i=>document.getElementById(i),f=(n,d=2)=>Number(n).toLocaleString("es-MX",{minimumFractionDigits:d,maximumFractionDigits:d});
const hm=t=>new Date(t).toLocaleTimeString("es-MX",{timeZone:TZ,hour:"2-digit",minute:"2-digit"}),dt=t=>new Date(t).toLocaleString("es-MX",{timeZone:TZ,day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"})+" CDMX";
const S={p:{},mxn:null,sol:null,toks:[],tokOk:false,chart:null,txs:[],last:0,errs:[]},TXC=JSON.parse(localStorage.getItem("wl_txc")||"{}");
$("scan").href="https://solscan.io/account/"+ADDR;
let base=JSON.parse(localStorage.getItem("wl_base2")||"null")||{usd:22.48};$("base").value=base.usd;
$("sb").onclick=()=>{const v=parseFloat($("base").value);if(v>0){base.usd=v;localStorage.setItem("wl_base2",JSON.stringify(base));render()}};
async function rpc(m,pa){let e;for(const u of RPCS){try{const j=await(await fetch(u,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({jsonrpc:"2.0",id:1,method:m,params:pa})})).json();if(j.error)throw new Error(j.error.message);return j.result}catch(x){e=x}}throw e}
async function gj(u){const r=await fetch(u);if(!r.ok)throw new Error(r.status);return r.json()}
const L={wallet:async()=>{S.sol=(await rpc("getBalance",[ADDR])).value/1e9},
tokens:async()=>{let a=[],ok=false;for(const p of TP){try{const r=await rpc("getTokenAccountsByOwner",[ADDR,{programId:p},{encoding:"jsonParsed"}]);ok=true;r.value.forEach(x=>{const i=x.account.data.parsed.info;if(i.tokenAmount.uiAmount>0)a.push({mint:i.mint,amt:i.tokenAmount.uiAmount})})}catch(e){}}
 S.tokOk=ok;if(a.length){try{const j=await gj("https://lite-api.jup.ag/price/v3?ids="+a.map(t=>t.mint).join(","));a.forEach(t=>t.price=j[t.mint]?.usdPrice??null)}catch(e){}}if(ok)S.toks=a},
precios:async()=>{S.p=await gj("https://api.coingecko.com/api/v3/simple/price?ids="+Object.keys(CG).join(",")+"&vs_currencies=usd&include_24hr_change=true")},
"USD/MXN":async()=>{S.mxn=(await gj("https://open.er-api.com/v6/latest/USD")).rates.MXN},
movimientos:async()=>{const sigs=await rpc("getSignaturesForAddress",[ADDR,{limit:10}]);const out=[];
 for(const s of sigs){let t=TXC[s.signature];if(!t){try{const r=await rpc("getTransaction",[s.signature,{encoding:"jsonParsed",maxSupportedTransactionVersion:0}]);const k=r.transaction.message.accountKeys.map(a=>a.pubkey||a);const i=k.indexOf(ADDR);
  const own=x=>(x||[]).filter(b=>b.owner===ADDR).map(b=>b.mint+":"+b.uiTokenAmount.amount).join();
  t={sig:s.signature,time:(r.blockTime||s.blockTime)*1000,d:i>=0?(r.meta.postBalances[i]-r.meta.preBalances[i])/1e9:0,fee:i===0?r.meta.fee/1e9:0,tok:own(r.meta.preTokenBalances)!==own(r.meta.postTokenBalances),err:!!r.meta.err};TXC[s.signature]=t}catch(e){continue}}out.push(t)}
 localStorage.setItem("wl_txc",JSON.stringify(TXC));S.txs=out},
chart:async()=>{if(!S.chart||Date.now()-S.chartT>300000){S.chart=(await gj("https://api.coingecko.com/api/v3/coins/solana/market_chart?vs_currency=usd&days=1")).prices;S.chartT=Date.now()}}};
const AG=[["esc","🛰️","Escáner","Revisa precios de SOL, BTC, ETH, JUP, BONK y WIF"],["ana","📈","Analista","Lee la gráfica de SOL de 24 h y dice si sube, baja o va de lado"],["rie","🛡️","Riesgo","Cuida las reglas: máx 10% por operación, stop de pérdida 7%"],["pro","💡","Propuestas","Arma ideas de compra; siempre esperan tu aprobación"],["eje","🤖","Ejecutor","Solo compra si tú dices OK en el chat"],["con","🧮","Contador","Cuenta depósitos, envíos y movimientos"]];
$("ag").innerHTML=AG.map(([id,e,n,d])=>`<div class="card" id="c_${id}"><div class="av">${e}</div><div><div class="nm">${n}</div><div class="do">${d}</div><div class="st" id="s_${id}"><span class="think">pensando</span></div></div></div>`).join("");
const logs=JSON.parse(sessionStorage.getItem("wl_log")||"[]");function lg(n,m){logs.unshift(hm(Date.now())+" "+n+": "+m);logs.length=Math.min(logs.length,60);sessionStorage.setItem("wl_log",JSON.stringify(logs));$("log").innerHTML=logs.map(x=>`<div>${x}</div>`).join("")}
function say(id,n,m,delay){const c=$("c_"+id),s=$("s_"+id);c.classList.add("busy");s.innerHTML='<span class="think">analizando datos</span>';
 setTimeout(()=>{c.classList.remove("busy");let i=0;const t=`<span class="t">${hm(Date.now())}</span>`;const iv=setInterval(()=>{s.innerHTML=t+m.slice(0,++i)+'<span class="think"></span>';if(i>=m.length){clearInterval(iv);s.innerHTML=t+m}},18);lg(n,m)},delay)}
let sch;Chart.defaults.color="#00ff41";Chart.defaults.borderColor="rgba(0,255,65,.15)";
function render(){const sp=S.p.solana?.usd;if(S.sol==null||sp==null)return;
 const rows=[{n:"SOL",amt:S.sol,v:S.sol*sp}].concat(S.toks.map(t=>({n:KN[t.mint]||"token desconocido",amt:t.amt,v:t.price!=null?t.amt*t.price:null})));
 const tot=rows.reduce((s,r)=>s+(r.v||0),0),d=tot-base.usd,pc=d/base.usd*100;
 $("usd").textContent="$"+f(tot)+" USD";$("mxn").textContent=S.mxn?"≈ MX$"+f(tot*S.mxn)+" pesos":"";
 $("pnl").innerHTML=`<span class="${d>=0?'up':'dn'}">${Math.abs(d)<0.005?"= Igual":d>0?"▲ Ganas":"▼ Pierdes"} $${f(Math.abs(d))} (${f(pc)}%)</span> <span class="mut">vs $${f(base.usd)}</span>`;
 $("hold").textContent=rows.map(r=>`${r.n}: ${f(r.amt,r.amt<1?4:2)}`).join(" · ")+(S.tokOk?"":" (otros tokens: RPC público no los deja leer)");
 const buys=S.txs.filter(t=>t.tok&&!t.err).length,ins=S.txs.filter(t=>t.d>0&&!t.err),outs=S.txs.filter(t=>t.d<-0.00001-t.fee&&!t.err);
 // agents
 const mk=Object.entries(CG).filter(([id])=>S.p[id]).map(([id,s])=>({s,c:S.p[id].usd_24h_change}));mk.sort((a,b)=>Math.abs(b.c)-Math.abs(a.c));
 const top=mk[0];say("esc","Escáner",`${top.s} ${top.c>=0?"+":""}${f(top.c,1)}% en 24 h, el que más se mueve. SOL ${S.p.solana.usd_24h_change>=0?"+":""}${f(S.p.solana.usd_24h_change,1)}%.`,300);
 let trend="lateral",ch=null,ch4=null;if(S.chart){const c=S.chart,a=c[0][1],z=c[c.length-1][1],h4=c[Math.max(0,c.length-49)][1];ch=(z-a)/a*100;ch4=(z-h4)/h4*100;trend=ch>1?"sube":ch<-1?"baja":"lateral";
  const lo=Math.min(...c.map(x=>x[1])),hi=Math.max(...c.map(x=>x[1]));say("ana","Analista",`SOL ${trend.toUpperCase()}: ${ch>=0?"+":""}${f(ch,2)}% en 24 h, ${ch4>=0?"+":""}${f(ch4,2)}% últimas 4 h. Rango $${f(lo)}–$${f(hi)}.`,900)}
 else say("ana","Analista","Esperando la gráfica de SOL (reintentando)…",900);
 const mx=tot*0.10;say("rie","Riesgo",`Saldo $${f(tot)} → máximo por operación $${f(mx)}. Stop 7%: si SOL baja a $${f(sp*0.93)} se vende.`,1500);
 const idea=trend==="sube"&&ch>3?`Idea: comprar hasta $${f(mx)} de SOL (tendencia +${f(ch,1)}%). Esperando tu aprobación.`:`Ninguna compra recomendada ahora (SOL ${trend}). Esperando tu aprobación para cualquier idea.`;say("pro","Propuestas",idea,2100);
 say("eje","Ejecutor",`Apagado: solo compra con tu OK. Compras hechas: ${buys}.`,2700);
 say("con","Contador",`${S.txs.length} movimientos recientes: ${ins.length} entradas, ${outs.length} salidas, ${buys} compras.`,3300);
 $("sum").textContent=`Tienes $${f(tot)} en ${rows.filter(r=>r.v).map(r=>r.n).join(" y ")}. ${buys?`Se han hecho ${buys} compra(s).`:"Nadie ha comprado nada."} Tus agentes están vigilando el mercado.`;
 $("mv").innerHTML=S.txs.length?S.txs.map(t=>{const amt=Math.abs(t.d),usd=amt*sp;const w=t.err?"⚠ Operación fallida (no se movió dinero)":t.tok?"🔄 Cambio de tokens (compra/venta)":t.d>0?`⬇️ Entraron ${f(amt,4)} SOL (~$${f(usd)})`:amt>0.00001?`⬆️ Salieron ${f(amt,4)} SOL (~$${f(usd)})`:"• Movimiento sin cambio de saldo";
  return`<div class="mv"><b>${w}</b><br><span class="mut">${dt(t.time)} · <a target=_blank rel=noopener href="https://solscan.io/tx/${t.sig}">ver detalle</a></span></div>`}).join(""):"Sin movimientos todavía.";
 if(S.chart){if(!sch)sch=new Chart($("sch"),{type:"line",data:{labels:[],datasets:[{label:"SOL (USD)",data:[],borderColor:"#00e5ff",pointRadius:0,tension:.2}]},options:{animation:false,plugins:{legend:{display:false}}}});
  sch.data.labels=S.chart.map(x=>hm(x[0]));sch.data.datasets[0].data=S.chart.map(x=>x[1]);sch.update()}}
async function tick(){S.errs=[];await Promise.all(Object.entries(L).map(([k,fn])=>fn().catch(()=>S.errs.push(k))));if(!S.errs.includes("wallet")&&!S.errs.includes("precios"))S.last=Date.now();
 $("err").textContent=S.errs.length?" · ⚠ reintentando: "+S.errs.join(", "):"";render()}
if(logs.length)$("log").innerHTML=logs.map(x=>`<div>${x}</div>`).join("");
let cd=REFRESH;setInterval(()=>{cd--;$("cd").textContent=cd;$("ago").textContent=S.last?Math.round((Date.now()-S.last)/1000):"--";if(cd<=0){cd=REFRESH;tick()}},1000);tick();
const cv=$("rain"),cx=cv.getContext("2d");let dr;function rs(){cv.width=innerWidth;cv.height=innerHeight;dr=Array(Math.floor(cv.width/16)).fill(0).map(()=>Math.random()*-50)}rs();addEventListener("resize",rs);
const chs="アイウエオカキクケコ01SOL$";setInterval(()=>{cx.fillStyle="rgba(0,0,0,.08)";cx.fillRect(0,0,cv.width,cv.height);cx.fillStyle="#00ff41";cx.font="14px monospace";dr.forEach((y,i)=>{cx.fillText(chs[Math.random()*chs.length|0],i*16,y*16);dr[i]=y*16>cv.height&&Math.random()>.975?0:y+1})},60);
</script></body></html>
